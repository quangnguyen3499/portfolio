# Local Healthchecks credentials. Keep the service bound to localhost.
HC_SECRET_KEY=replace-with-a-random-secret
HC_DB_PASSWORD=replace-with-a-random-password

# SMTP settings for real email delivery. For Gmail, use an App Password, not your account password.
HC_SMTP_HOST=smtp.gmail.com
HC_SMTP_PORT=587
HC_SMTP_USER=your-google-account@gmail.com
HC_SMTP_PASSWORD=replace-with-a-gmail-app-password
HC_SMTP_FROM=your-google-account@gmail.com
HC_SMTP_USE_TLS=True
HC_SMTP_USE_SSL=False